{
  "name": "@revolist/scheduler-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "RevoGrid Scheduler showcase with calendar and resource planning across four frameworks.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": { "node": ">=20", "pnpm": ">=10" },
  "repository": { "type": "git", "url": "https://github.com/revolist/scheduler.git" },
  "homepage": "https://scheduler.rv-grid.com/",
  "bugs": { "url": "https://github.com/revolist/scheduler/issues" },
  "scripts": {
    "dev": "pnpm dev:ts",
    "dev:ts": "vite --mode ts",
    "dev:react": "vite --mode react",
    "dev:vue": "vite --mode vue",
    "dev:angular": "vite --mode angular",
    "build": "pnpm build:ts",
    "build:ts": "vite build --mode ts",
    "build:react": "vite build --mode react",
    "build:vue": "vite build --mode vue",
    "build:angular": "vite build --mode angular",
    "build:frameworks": "node scripts/build-frameworks.mjs",
    "build:pages": "pnpm build && node scripts/build-pages.mjs",
    "preview": "vite preview",
    "test": "pnpm test:unit && pnpm test:repository",
    "test:unit": "vitest run",
    "test:repository": "node scripts/verify-repository.mjs",
    "test:e2e": "playwright test",
    "media:verify": "node scripts/verify-repository.mjs",
    "media:inspect": "pnpm build && node scripts/record-media.mjs --inspect",
    "media:record": "pnpm build && node scripts/record-media.mjs"
  },
  "dependencies": {
    "@angular/common": "20.3.26",
    "@angular/compiler": "20.3.26",
    "@angular/core": "20.3.26",
    "@angular/platform-browser": "20.3.26",
    "@angular/platform-browser-dynamic": "20.3.26",
    "@revolist/angular-datagrid": "4.25.1",
    "@revolist/react-datagrid": "4.25.1",
    "@revolist/revogrid": "4.25.1",
    "@revolist/revogrid-enterprise": "npm:@revolist/rv-enterprise-trial@2.5.0",
    "@revolist/revogrid-pro": "npm:@revolist/rv-pro-trial@2.5.0",
    "@revolist/vue3-datagrid": "4.25.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "vue": "3.5.40",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.3",
    "@angular/build": "20.3.32",
    "@angular/cli": "20.3.32",
    "@angular/compiler-cli": "20.3.26",
    "@playwright/test": "1.59.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitejs/plugin-vue": "5.2.4",
    "jsdom": "29.1.1",
    "playwright": "1.59.1",
    "sass-embedded": "1.100.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.10",
    "vue-tsc": "2.2.12"
  }
}
